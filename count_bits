#include <stdio.h>

int count_ones_in_binary(int num) {
    int count = 0;
    while (num > 0) {
        if (num % 2 != 0) {
            count++;
        }
        num /= 2;
    }
    return count;
}

void print_bit_counts_up_to(int limit) {
    int current_num;
    printf("[");
    for (current_num = 0; current_num <= limit; current_num++) {
        printf("%d", count_ones_in_binary(current_num));
        if (current_num < limit) {
            printf(",");
        }
    }
    printf("]\n");
}

int main(void) {
    int user_input = 0;
    Printf("Enter a number");
    if (scanf("%d", &user_input) != 1 || user_input < 0) {
        return 1;
    }
    print_bit_counts_up_to(user_input);
    return 0;
}
