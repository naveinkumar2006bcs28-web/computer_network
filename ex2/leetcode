#include <stdio.h>
#include <string.h>
#include <stdlib.h>

char* addBinary(char* a, char* b) {
    int len_a = strlen(a);
    int len_b = strlen(b);

    // Maximum possible length + 1 for carry
    int max_len = (len_a > len_b ? len_a : len_b) + 1;

    // Allocate memory for result and null terminator
    char* result = (char*)malloc((max_len + 1) * sizeof(char));
    result[max_len] = '\0';

    int i = len_a - 1;
    int j = len_b - 1;
    int k = max_len - 1;
    int carry = 0;

    // Traverse both strings from right to left
    while (i >= 0 || j >= 0 || carry > 0) {
        int sum = carry;

        if (i >= 0) {
            sum += a[i] - '0';
            i--;
        }

        if (j >= 0) {
            sum += b[j] - '0';
            j--;
        }

        // Calculate carry and result bit
        carry = sum / 2;
        result[k] = (sum % 2) + '0';
        k--;
    }

    // Remove unused leading position
    if (k == 0) {
        return &result[1];
    }

    return result;
}

// Simple test block for verification
int main() {
    char a[] = "1010";
    char b[] = "1011";

    char* sum = addBinary(a, b);

    printf("Binary Sum of %s and %s is: %s\n", a, b, sum);

    return 0;
}
