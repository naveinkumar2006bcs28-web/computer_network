#include <stdio.h>
#include <stdlib.h>

/* Definition for Trie Node */
typedef struct TrieNode {
    struct TrieNode* children[2];
} TrieNode;

/* Function to create a new Trie Node */
TrieNode* createNode() {
    TrieNode* node = (TrieNode*)malloc(sizeof(TrieNode));
    node->children[0] = NULL;
    node->children[1] = NULL;
    return node;
}

/* Function to insert a number into the Trie */
void insert(TrieNode* root, int num) {
    TrieNode* curr = root;
    int i;

    for (i = 30; i >= 0; i--) {
        int bit = (num >> i) & 1;
        if (!curr->children[bit]) {
            curr->children[bit] = createNode();
        }
        curr = curr->children[bit];
    }
}

/* Function to find the maximum XOR for a given number against the Trie */
int getMaxXOR(TrieNode* root, int num) {
    TrieNode* curr = root;
    int maxXOR = 0;
    int i;

    for (i = 30; i >= 0; i--) {
        int bit = (num >> i) & 1;
        int toggleBit = 1 - bit;

        if (curr->children[toggleBit]) {
            maxXOR |= (1 << i);
            curr = curr->children[toggleBit];
        } else {
            curr = curr->children[bit];
        }
    }
    return maxXOR;
}

/* Helper function to free Trie memory */
void freeTrie(TrieNode* root) {
    if (!root) return;
    freeTrie(root->children[0]);
    freeTrie(root->children[1]);
    free(root);
}

/* Main logic function to find maximum XOR in the array */
int findMaximumXOR(int* nums, int numsSize) {
    TrieNode* root;
    int globalMax = 0;
    int i;

    if (numsSize < 2) return 0;

    root = createNode();
    insert(root, nums[0]);

    for (i = 1; i < numsSize; i++) {
        int currentMax = getMaxXOR(root, nums[i]);
        if (currentMax > globalMax) {
            globalMax = currentMax;
        }
        insert(root, nums[i]);
    }

    freeTrie(root);
    return globalMax;
}

int main() {
    int n;
    int i;
    int* nums;
    int result;

    /* 1. Get array size from user */
    printf("Enter the number of elements: ");
    if (scanf("%d", &n) != 1 || n <= 0) {
        printf("Invalid array size.\n");
        return 1;
    }

    /* 2. Dynamically allocate memory for the array */
    nums = (int*)malloc(n * sizeof(int));
    if (nums == NULL) {
        printf("Memory allocation failed.\n");
        return 1;
    }

    /* 3. Get array elements from user */
    printf("Enter %d integers separated by spaces or newlines:\n", n);
    for (i = 0; i < n; i++) {
        if (scanf("%d", &nums[i]) != 1) {
            printf("Invalid input entry.\n");
            free(nums);
            return 1;
        }
    }

    /* 4. Calculate and display output */
    result = findMaximumXOR(nums, n);
    printf("Maximum XOR Result: %d\n", result);

    /* 5. Clean up allocated array memory */
    free(nums);
    return 0;
}

