#include <stdio.h>
#include <stdlib.h>

int* countBits(int n, int* returnSize) {
    int i;
    int* ans;

    *returnSize = n + 1;
    ans = (int*)malloc((*returnSize) * sizeof(int));


    if (ans == NULL) {
        return NULL;
    }

    ans[0] = 0;
    for (i = 1; i <= n; i++) {
        ans[i] = ans[i >> 1] + (i & 1);
    }

    return ans;
}

int main() {
    int n;
    int returnSize;
    int i;
    int* result;


    printf("Enter an integer n (0 to 100000): ");
    if (scanf("%d", &n) != 1) {
        printf("Error: Invalid numeric input.\n");
        return 1;
    }


    if (n < 0 || n > 100000) {
        printf("Error: Input out of bounds. Please enter a number between 0 and 100000.\n");
        return 1;
    }

    result = countBits(n, &returnSize);
    if (result == NULL) {
        printf("Error: Memory allocation failed.\n");
        return 1;
    }


    printf("[");
    for (i = 0; i < returnSize; i++) {
        printf("%d", result[i]);
        if (i < returnSize - 1) {
            printf(",");
        }
    }
    printf("]\n");

    free(result);
    return 0;
}

